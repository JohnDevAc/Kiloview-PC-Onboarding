<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NDI Configurator PC Agent Setup</AssemblyName>
    <RootNamespace>KiloviewPcOnboarding</RootNamespace>
    <AssemblyTitle>NDI Configurator PC Agent Setup</AssemblyTitle>
    <Description>Install the PC Agent and apply server-local or locally approved remote onboarding settings.</Description>
    <ApplicationIcon>assets\PcAgent.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kiloview.PcOnboarding.Validation" />
    <InternalsVisibleTo Include="NDI.Suite.Interop.Validation" />
    <Compile Remove="Agent\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <None Remove="Agent\**\*" />
    <None Remove="tests\**\*" />
    <EmbeddedResource Include="LICENSE.md" LogicalName="KiloviewPcOnboarding.License.md" />
    <EmbeddedResource Include="assets\PcAgent.ico" LogicalName="KiloviewPcOnboarding.BrandIcon.ico" />
  </ItemGroup>
</Project>
