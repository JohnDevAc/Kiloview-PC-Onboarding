<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NDI Configurator PC Agent</AssemblyName>
    <RootNamespace>KiloviewPcAgent</RootNamespace>
    <Product>NDI Configurator PC Agent</Product>
    <AssemblyTitle>NDI Configurator PC Agent</AssemblyTitle>
    <Description>Tray agent for discovery, monitoring, remote onboarding, and managed NDI multicast.</Description>
    <ApplicationIcon>..\assets\PcAgent.ico</ApplicationIcon>
    <ApplicationManifest>agent.manifest</ApplicationManifest>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\DownloadReadiness.cs" Link="DownloadReadiness.cs" />
    <Compile Include="..\OnboardingOutcomes.cs" Link="OnboardingOutcomes.cs" />
    <Compile Include="..\SetupOperationLease.cs" Link="SetupOperationLease.cs" />
    <EmbeddedResource Include="..\assets\PcAgent.ico" Link="assets\PcAgent.ico" LogicalName="KiloviewPcAgent.BrandIcon.ico" />
  </ItemGroup>
</Project>
